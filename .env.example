# EasyFlex self-hosted deployment
# Copy this file to .env and then replace the CHANGE_ME values.

POSTGRES_DB=easyflex
POSTGRES_USER=easyflex
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

EASYFLEX_ENV=production
EASYFLEX_SECRET_KEY=CHANGE_ME_SECRET_KEY
EASYFLEX_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Local/LAN mode:
# CADDY_SITE_ADDRESS=:80
#
# Public HTTPS mode:
# CADDY_SITE_ADDRESS=easyflex.example.com
CADDY_SITE_ADDRESS=:80

WEB_CONCURRENCY=2

MAX_PDF_FILES_PER_BATCH=100
MAX_PDF_FILE_BYTES=26214400
MAX_BATCH_TOTAL_BYTES=262144000
MAX_BATCH_TOTAL_PAGES=500
MAX_TABLE_FILE_BYTES=33554432
